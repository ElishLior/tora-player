# =============================================================================
# Tora Player - Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in the values.
# Variables prefixed with NEXT_PUBLIC_ are exposed to the browser.
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase (PostgreSQL database and auth)
# Get these from: https://supabase.com/dashboard/project/_/settings/api
# -----------------------------------------------------------------------------

# Public Supabase project URL (exposed to browser)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co

# Public anon key (exposed to browser). Safe only because RLS allows the public
# to read published content and nothing else (migration 009).
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Service role key (server only, NEVER expose to browser). Every admin write,
# notification send and push-subscription write uses it after authorization.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# -----------------------------------------------------------------------------
# Cloudflare R2 (S3-compatible audio file storage)
# Get these from: https://dash.cloudflare.com/ > R2 > Manage R2 API Tokens
# -----------------------------------------------------------------------------

# Cloudflare account ID (found in the R2 dashboard URL)
R2_ACCOUNT_ID=xxxxx

# R2 API token credentials (create an API token with read/write access)
R2_ACCESS_KEY_ID=xxxxx
R2_SECRET_ACCESS_KEY=xxxxx

# R2 bucket name for storing audio files
R2_BUCKET_NAME=tora-player-audio

# Public URL for the R2 bucket (via custom domain or R2 public access)
# Used for constructing audio URLs served to clients
R2_PUBLIC_URL=https://audio.toraplayer.com

# -----------------------------------------------------------------------------
# Google Cast SDK (Chromecast support)
# CC1AD845 = Default Media Receiver (fine for development)
# Register a custom receiver at: https://cast.google.com/publish/
# -----------------------------------------------------------------------------
NEXT_PUBLIC_CAST_APP_ID=CC1AD845

# -----------------------------------------------------------------------------
# Application Settings
# -----------------------------------------------------------------------------

# Public base URL of the application (OG tags, share links, auth redirects,
# links inside notification emails). Production: https://tora-player.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Display name of the application
NEXT_PUBLIC_APP_NAME=Tora Player

# -----------------------------------------------------------------------------
# Admin access
# An admin is a signed-in user (Google or email code) whose confirmed email is
# listed here, or whose profiles.role is 'admin' (set in the Supabase dashboard).
# -----------------------------------------------------------------------------

# Comma-separated admin emails, e.g. lior5750@gmail.com
ADMIN_EMAILS=lior5750@gmail.com

# Optional password fallback for the admin area. Enabled only when BOTH are
# set. The secret signs the session cookie (HMAC); use 32+ random characters,
# e.g. `openssl rand -base64 48`. Changing either value logs out every
# password session. Leave both empty to disable password login entirely.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# -----------------------------------------------------------------------------
# New-lesson notifications
# -----------------------------------------------------------------------------

# Web Push (VAPID). Generate once with: npx web-push generate-vapid-keys
# The public key is needed on the server and in the browser (same value).
VAPID_PUBLIC_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact for push services: mailto: address or https URL
VAPID_SUBJECT=mailto:lior5750@gmail.com

# Optional email notifications via Resend (https://resend.com). Emails go to
# signed-in users who kept "email me when a new lesson is published" on.
# NOTIFY_FROM_EMAIL must use a domain verified in Resend.
RESEND_API_KEY=
NOTIFY_FROM_EMAIL="Tora Player <lessons@example.com>"
