# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/
# ffmpeg.wasm core, copied from node_modules by scripts/copy-ffmpeg-core.mjs
/public/ffmpeg/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# babysitter SDK
.a5c/

# typescript
*.tsbuildinfo
next-env.d.ts
.env*.local

# Local WhatsApp exports and import planning
Lessons DB/

# Per-machine agent settings (may contain tokens)
.claude/settings.local.json
